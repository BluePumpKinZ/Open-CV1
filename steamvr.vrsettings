{
   "jsonid" : "vrsettings",
   "steamvr": {
      "enableHomeApp": false,
      "enableLinuxVulkanAsync": false,
      "supersampleManualOverride": true,
      "supersampleScale": 1.0
   },
   "driver_lighthouse": {
		"enable": false
	},
   "driver_oculus": {
		"enable": false
	},
   "driver_oculus_legacy": {
		"enable": false
	},
   "driver_openhmd" : {
		 "enable": true,
      "displayFrequency": 90,
      "secondsFromVsyncToPhotons": 0.011,
      "poseOffsetX": 0.0,
      "poseOffsetY": 0.0,
      "poseOffsetZ": 0.0,
      "poseYawDegrees": 0.0,
      "synthesizeAngularAcceleration": true
   },
   "version" : "1"
}
